Manifest.toml
test/Manifest.toml
# EXCEPTION: bench's manifest IS tracked — it pins the GenericSchur + JLD2 resolution the CI
# benchmark steps (`julia --project=bench Pkg.instantiate()`) depend on, so a fresh CI resolve
# can't silently pull a broken upstream version. The top-level and test manifests stay local:
# a package must keep testing against a fresh resolve, which is what its users install.
!/bench/Manifest.toml

# Machine-local preferences (AMDGPU tuning, pdiv_accurate on FP64-less iGPUs)
LocalPreferences.toml
test/LocalPreferences.toml

# benchmark scratch: generated outputs only (results/ holds every script's output,
# including nit_chunk_sweep's results/adaptive/)
bench/results/
bench/plots/
bench/schur_cache/
bench/eigtool/

# Generated Documenter HTML output
docs/build/
# Figures generated by the example scripts (the demo saves one by default)
examples/*.png
